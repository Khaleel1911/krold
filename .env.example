# Copy to .env.local (never commit real values) and fill in.

# Cloudinary — stores blog posts and every uploaded image, video and file.
# Find these at https://console.cloudinary.com → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: the Cloudinary folder everything goes in (default: krold-blog)
# CLOUDINARY_FOLDER=krold-blog

# Blog admin login at /admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
# A long random string (32+ characters) that signs login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
